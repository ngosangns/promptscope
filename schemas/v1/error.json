{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngosangns/promptscope/schemas/v1/error.json",
  "title": "error",
  "description": "stdout of a failed command that was run with --json. The process exit code equals error.exit. promptscope update keeps its own object and does not use this envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "exit", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "failed-generic",
            "usage",
            "unavailable",
            "protocol",
            "failed",
            "needs-confirm",
            "unauthorized",
            "conflict"
          ]
        },
        "exit": {
          "type": "integer",
          "enum": [1, 2, 3, 4, 5, 6, 7, 8]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string",
          "description": "Omitted when there is nothing to add. Never null."
        }
      }
    }
  }
}
